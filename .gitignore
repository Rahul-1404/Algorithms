# Python PowerPoint Project .gitignore

# Generated PowerPoint files (except in samples/ directory)
*.pptx
!samples/*.pptx

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Generated images
*.png
*.jpg
*.jpeg
*.gif

# Thumbnails directory
thumbnails/

# Output directories
output/
examples_output/

# OS files
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Test files
test_*.pptx
demo*.pptx
*_test.pptx

# Distribution
dist/
build/
*.egg-info/
